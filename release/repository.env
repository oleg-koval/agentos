# AgentOS signed package repository. Committed to the tree because bootstrap.sh
# needs both values before any package repository is reachable.
#
# AGENTOS_SIGNING_FINGERPRINT is the PRIMARY key (the trust anchor, no expiry),
# not the signing subkey. Rotating the subkey must not change this value.
AGENTOS_REPO_BASE_URL=https://oleg-koval.github.io/agentos
AGENTOS_SIGNING_FINGERPRINT=EAC73D1D595C8F7D809D42EB268D28C12D93BC1B
