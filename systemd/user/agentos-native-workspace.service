[Unit]
Description=AgentOS native Workspace
After=agentosd.service
Wants=agentosd.service
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStartPre=/usr/bin/sh -c 'for i in $(seq 1 60); do [ -n "$WAYLAND_DISPLAY" ] && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/bin/agentos-native-workspace
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
